---
/**
 * /blog/[slug] — dev.to articles, statically generated at build time.
 * List:   https://dev.to/api/articles?username=ogisetiawan
 * Detail: https://dev.to/api/articles/{id} (includes body_html)
 *
 * Canonical points to the original dev.to URL (syndicated content).
 */
import BaseLayout from "../../components/layout/BaseLayout.astro";
import { ArrowLeft, Calendar, Clock, ExternalLink } from "@lucide/astro";
import { portfolioData as portfolio } from "../../data/portfolio";
import {
  DEVTO_USERNAME,
  articleTags,
  fetchAllDevtoArticles,
  formatPublishDate,
  type DevtoArticle,
} from "../../lib/devto";

export async function getStaticPaths() {
  const articles = await fetchAllDevtoArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: DevtoArticle;
}

const { article } = Astro.props;

const displayName = portfolio.profile.name.replace(/^I'm\s+/i, "").trim();
const tags = articleTags(article);
const publishedLabel = formatPublishDate(article.published_at);

const SITE = "https://ogisetiawan.my.id";
const pageUrl = `${SITE}/blog/${article.slug}/`;

const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.title,
  description: article.description,
  image: article.social_image,
  url: pageUrl,
  mainEntityOfPage: article.canonical_url,
  isBasedOn: article.canonical_url,
  datePublished: article.published_at,
  dateModified: article.edited_at ?? article.published_at,
  keywords: tags.join(", "),
  author: {
    "@type": "Person",
    "@id": `${SITE}/#person`,
    name: displayName,
    url: SITE,
  },
};
---

<BaseLayout
  title={`${article.title} — ${displayName}`}
  description={article.description}
  image={article.social_image}
  imageWidth={1200}
  imageHeight={627}
  canonicalUrl={article.canonical_url}
  ogType="article"
>
  <main
    class="bg-page px-4 py-16 text-gray-900 transition-colors duration-300 sm:px-6 lg:px-8 dark:bg-gray-900 dark:text-gray-100"
  >
    <article class="mx-auto max-w-3xl">
      <nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm" aria-label="Blog navigation">
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 font-semibold text-gray-600 transition-colors hover:text-accent-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 dark:text-gray-400 dark:hover:text-accent-400"
        >
          <ArrowLeft class="h-4 w-4" aria-hidden="true" />
          All posts
        </a>
        <a
          href="/#blog"
          class="font-semibold text-gray-500 transition-colors hover:text-accent-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 dark:text-gray-500 dark:hover:text-accent-400"
        >
          Home
        </a>
      </nav>

      <header class="mt-8">
        {
          tags.length > 0 && (
            <ul class="flex flex-wrap gap-2" aria-label="Article tags">
              {tags.map((tag) => (
                <li class="rounded-full bg-accent-100 px-3 py-1 font-mono text-xs font-semibold text-accent-800 dark:bg-accent-950 dark:text-accent-300">
                  #{tag}
                </li>
              ))}
            </ul>
          )
        }

        <h1
          class="mt-4 text-3xl font-heading font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
        >
          {article.title}
        </h1>

        <div
          class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-gray-600 dark:text-gray-400"
        >
          <span class="inline-flex items-center gap-1.5">
            <Calendar class="h-4 w-4" aria-hidden="true" />
            <time datetime={article.published_at}>{publishedLabel}</time>
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Clock class="h-4 w-4" aria-hidden="true" />
            {article.reading_time_minutes} min read
          </span>
        </div>
      </header>

      {
        article.cover_image && (
          <img
            src={article.cover_image}
            alt={`Cover illustration for the article "${article.title}"`}
            width="1000"
            height="420"
            class="mt-8 w-full rounded-2xl border border-gray-200 dark:border-gray-800"
            loading="eager"
            decoding="async"
          />
        )
      }

      <div class="devto-article mt-10" set:html={article.body_html} />

      <footer
        class="mt-12 rounded-2xl border border-gray-200 bg-elevated p-6 dark:border-gray-800 dark:bg-gray-800/60"
      >
        <p class="text-sm text-gray-600 dark:text-gray-300">
          This article was originally published on DEV Community.
        </p>
        <a
          href={article.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-accent-700 transition-colors hover:text-accent-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 dark:text-accent-400 dark:hover:text-accent-300"
        >
          Read &amp; discuss on dev.to/{DEVTO_USERNAME}
          <ExternalLink class="h-4 w-4" aria-hidden="true" />
        </a>
      </footer>
    </article>
  </main>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(blogPostingJsonLd)} />

<style is:global>
  /* dev.to body_html styling — plugin-free "prose" for injected markup */
  .devto-article {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-gray-700, #374151);
  }
  .dark .devto-article {
    color: #d1d5db;
  }

  .devto-article h2,
  .devto-article h3,
  .devto-article h4 {
    margin-top: 2em;
    margin-bottom: 0.6em;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #111827;
  }
  .dark .devto-article h2,
  .dark .devto-article h3,
  .dark .devto-article h4 {
    color: #ffffff;
  }
  .devto-article h2 {
    font-size: 1.5rem;
  }
  .devto-article h3 {
    font-size: 1.25rem;
  }
  .devto-article h4 {
    font-size: 1.1rem;
  }

  .devto-article p {
    margin: 1.1em 0;
  }

  .devto-article a {
    color: var(--color-accent-700);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .devto-article a:hover {
    color: var(--color-accent-600);
  }
  .dark .devto-article a {
    color: var(--color-accent-400);
  }
  .dark .devto-article a:hover {
    color: var(--color-accent-300);
  }

  .devto-article ul,
  .devto-article ol {
    margin: 1.1em 0;
    padding-left: 1.5em;
  }
  .devto-article ul {
    list-style: disc;
  }
  .devto-article ol {
    list-style: decimal;
  }
  .devto-article li {
    margin: 0.4em 0;
  }

  .devto-article blockquote {
    margin: 1.5em 0;
    border-left: 3px solid var(--color-accent-500);
    padding-left: 1.25em;
    font-style: italic;
    color: #4b5563;
  }
  .dark .devto-article blockquote {
    color: #9ca3af;
  }

  .devto-article code {
    font-family: var(--font-mono), monospace;
    font-size: 0.875em;
    background: #eef0e8;
    border-radius: 0.375rem;
    padding: 0.15em 0.4em;
  }
  .dark .devto-article code {
    background: #31313a;
  }

  .devto-article pre {
    margin: 1.5em 0;
    overflow-x: auto;
    border-radius: 0.75rem;
    background: #26262d;
    padding: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .devto-article pre code {
    background: transparent;
    padding: 0;
    color: #e4e6dc;
  }

  .devto-article img {
    margin: 1.5em auto;
    border-radius: 0.75rem;
    max-width: 100%;
    height: auto;
  }

  .devto-article hr {
    margin: 2.5em 0;
    border-color: #e5e7eb;
  }
  .dark .devto-article hr {
    border-color: #374151;
  }

  .devto-article table {
    margin: 1.5em 0;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .devto-article th,
  .devto-article td {
    border: 1px solid #e5e7eb;
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .dark .devto-article th,
  .dark .devto-article td {
    border-color: #374151;
  }
</style>
