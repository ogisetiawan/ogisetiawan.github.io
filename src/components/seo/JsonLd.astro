---
/**
 * GEO-oriented Knowledge Graph JSON-LD
 * Person ↔ WebSite ↔ WebPage via connected @id references
 */
const SITE = "https://ogisetiawan.my.id";
const PERSON_ID = `${SITE}/#about`;
const WEBSITE_ID = `${SITE}/#website`;
const WEBPAGE_ID = `${SITE}/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": PERSON_ID,
      name: "Ogi Setiawan",
      jobTitle: "Full Stack Software Engineer",
      description:
        "Fullstack Developer specializing in enterprise web applications, AI workflow automation, and legacy system modernization.",
      url: SITE,
      image: `${SITE}/og-image.png`,
      worksFor: {
        "@type": "Organization",
        name: "Behn Meyer Group",
      },
      address: {
        "@type": "PostalAddress",
        addressLocality: "South Tangerang",
        addressRegion: "Banten",
        addressCountry: "ID",
      },
      sameAs: [
        "https://www.linkedin.com/in/ogi-setiawan-software-engineer/",
        "https://github.com/ogisetiawan",
        "https://dev.to/ogisetiawan",
      ],
      knowsAbout: [
        "Web Development",
        "Enterprise Systems",
        "AI Automation",
        "React",
        "Node.js",
        "PHP",
        "SAP Integration",
        "Astro",
        "TypeScript",
      ],
    },
    {
      "@type": "WebSite",
      "@id": WEBSITE_ID,
      url: SITE,
      name: "Ogi Setiawan Portfolio",
      description:
        "The official portfolio of Ogi Setiawan, showcasing enterprise web projects and technical expertise.",
      publisher: { "@id": PERSON_ID },
      inLanguage: "id-ID",
    },
    {
      "@type": "WebPage",
      "@id": WEBPAGE_ID,
      url: SITE,
      name: "Ogi Setiawan - Regional Web Developer & Fullstack Engineer",
      isPartOf: { "@id": WEBSITE_ID },
      about: { "@id": PERSON_ID },
      datePublished: "2026-08-01",
      dateModified: "2026-09-04",
    },
  ],
};

const jsonLdString = JSON.stringify(jsonLd);
---

<script type="application/ld+json" set:html={jsonLdString} />
