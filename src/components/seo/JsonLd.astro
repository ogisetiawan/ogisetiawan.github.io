---
import { portfolioData as portfolio } from "../../data/portfolio";

interface Props {
  title: string;
  description: string;
  canonicalURL: URL;
  ogImage: URL;
  siteOrigin: URL;
  displayName: string;
}

const { title, description, canonicalURL, ogImage, siteOrigin, displayName } =
  Astro.props;

const siteUrl = siteOrigin.href.replace(/\/$/, "");
const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;
const profilePageId = `${canonicalURL.href.replace(/\/$/, "")}/#profilepage`;

const currentJob = portfolio.experience.find((job) => job.current);
const sameAs = portfolio.social.map((item) => item.url);

const alumniOf = portfolio.education.map((edu) => ({
  "@type": "EducationalOrganization",
  name: edu.institution,
}));

const hasCredential = portfolio.certifications.slice(0, 6).map((cert) => ({
  "@type": "EducationalOccupationalCredential",
  name: cert.name,
  credentialCategory: "Certificate",
  recognizedBy: {
    "@type": "Organization",
    name: cert.issuer,
  },
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: `${siteUrl}/`,
      name: `${displayName} Portfolio`,
      description: portfolio.profile.about,
      inLanguage: "en",
      publisher: { "@id": personId },
      author: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: displayName,
      url: `${siteUrl}/`,
      image: {
        "@type": "ImageObject",
        url: ogImage.href,
        width: 612,
        height: 408,
        caption: `${displayName} — ${portfolio.profile.title}`,
      },
      jobTitle: portfolio.profile.title,
      description: portfolio.profile.about,
      email: portfolio.contact.email,
      telephone: portfolio.contact.phone,
      address: {
        "@type": "PostalAddress",
        addressLocality: "South Tangerang",
        addressRegion: "Banten",
        addressCountry: "ID",
      },
      nationality: {
        "@type": "Country",
        name: "Indonesia",
      },
      knowsAbout: [
        ...new Set([
          ...portfolio.profile.roles,
          ...portfolio.skills.programming.map((skill) => skill.name),
        ]),
      ],
      sameAs,
      alumniOf,
      hasCredential,
      ...(currentJob
        ? {
            worksFor: {
              "@type": "Organization",
              name: currentJob.company,
            },
          }
        : {}),
    },
    {
      "@type": "ProfilePage",
      "@id": profilePageId,
      url: canonicalURL.href,
      name: title,
      description,
      inLanguage: "en",
      isPartOf: { "@id": websiteId },
      about: { "@id": personId },
      mainEntity: { "@id": personId },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: ogImage.href,
      },
    },
  ],
};

const jsonLdString = JSON.stringify(jsonLd);
---

<script type="application/ld+json" set:html={jsonLdString} />
