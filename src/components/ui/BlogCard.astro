---
import { Calendar, Clock, ArrowRight } from "@lucide/astro";
import {
  formatPublishDate,
  type DevtoArticleListItem,
} from "../../lib/devto";

interface Props {
  article: DevtoArticleListItem;
  /** Stagger index for scroll-reveal */
  stagger?: number;
}

const { article, stagger = 0 } = Astro.props;
const tags = article.tag_list ?? [];
const href = `/blog/${article.slug}/`;
---

<article
  class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-elevated shadow-sm transition-shadow duration-300 hover:shadow-md dark:border-gray-800 dark:bg-gray-800"
  data-reveal-item
  style={`--stagger: ${stagger}`}
>
  <a
    href={href}
    class="block aspect-[1000/420] overflow-hidden bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-inset dark:bg-gray-900"
    tabindex="-1"
    aria-hidden="true"
  >
    {
      article.cover_image ? (
        <img
          src={article.cover_image}
          alt=""
          width="1000"
          height="420"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div
          class="flex h-full w-full items-center justify-center bg-gradient-to-br from-accent-100 to-gray-100 dark:from-accent-950 dark:to-gray-900"
          aria-hidden="true"
        >
          <span class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-700 dark:text-accent-400">
            DEV.to
          </span>
        </div>
      )
    }
  </a>

  <div class="flex flex-1 flex-col p-6">
    {
      tags.length > 0 && (
        <ul class="mb-3 flex flex-wrap gap-2" aria-label="Tags">
          {tags.slice(0, 3).map((tag) => (
            <li class="rounded-full bg-accent-100 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-accent-800 dark:bg-accent-950 dark:text-accent-300">
              #{tag}
            </li>
          ))}
        </ul>
      )
    }

    <h3 class="text-lg font-heading font-semibold tracking-tight text-gray-900 dark:text-white">
      <a
        href={href}
        class="transition-colors hover:text-accent-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 dark:hover:text-accent-400"
      >
        {article.title}
      </a>
    </h3>

    <p class="mt-2 flex-1 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
      {article.description}
    </p>

    <div
      class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-gray-100 pt-4 text-xs text-gray-500 dark:border-gray-700 dark:text-gray-400"
    >
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span class="inline-flex items-center gap-1.5">
          <Calendar class="h-3.5 w-3.5" aria-hidden="true" />
          <time datetime={article.published_at}>
            {formatPublishDate(article.published_at)}
          </time>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Clock class="h-3.5 w-3.5" aria-hidden="true" />
          {article.reading_time_minutes} min read
        </span>
      </div>
      <a
        href={href}
        class="inline-flex items-center gap-1 font-semibold text-accent-700 transition-colors hover:text-accent-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 dark:text-accent-400 dark:hover:text-accent-300"
      >
        Read
        <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
      </a>
    </div>
  </div>
</article>
