---
/**
 * Decorative curved (meliuk) arrow — accent stroke, aria-hidden.
 */
interface Props {
  class?: string;
  flip?: boolean;
}

const { class: className = "h-8 w-16", flip = false } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 80 40"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class:list={["text-accent", flip && "-scale-x-100", className]}
>
  <path
    d="M6 12C14 30 42 36 68 16"
    stroke="currentColor"
    stroke-width="2.75"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <path
    d="M56 10.5 68 16l-9.5 9"
    stroke="currentColor"
    stroke-width="2.75"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
