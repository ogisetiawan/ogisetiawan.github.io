---
import { ArrowRight, FileDown, MapPin } from "@lucide/astro";
import { portfolioData as portfolio } from "../../data/portfolio";

const { profile, social, projects, certifications, experience } = portfolio;

const yearsExperience = Math.max(
  1,
  Math.floor(
    (Date.now() - new Date(profile.experienceStartDate).getTime()) /
      (365.25 * 24 * 60 * 60 * 1000)
  )
);

const stats = [
  { value: `${yearsExperience}+`, label: "Years Experience" },
  { value: `${projects.length}+`, label: "Projects Delivered" },
  { value: `${certifications.length}`, label: "Certifications" },
];

const currentJob = experience.find((job) => job.current);

const socialIcons: Record<string, string> = {
  linkedin:
    "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  github:
    "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  twitter:
    "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
  "stack-overflow":
    "M15.725 0l-1.72 1.277 6.39 8.588 1.716-1.277L15.725 0zm-3.94 3.418l-1.369 1.644 8.225 6.85 1.369-1.644-8.225-6.85zm-3.15 4.465l-.905 1.94 9.702 4.517.904-1.94-9.701-4.517zm-1.85 4.86l-.44 2.093 10.473 2.201.44-2.092-10.473-2.203zM1.89 15.47V24h19.19v-8.53h-2.133v6.397H4.021v-6.396H1.89zm4.265 2.133v2.13h10.66v-2.13H6.155z",
  dev: "M7.826 10.083a.784.784 0 0 0-.468-.175h-.701v4.198h.701a.786.786 0 0 0 .469-.176c.155-.117.233-.292.233-.525v-2.798c.001-.233-.079-.408-.234-.524zM19.236 3H4.764C3.791 3 3.002 3.787 3 4.76v14.48c.002.973.791 1.76 1.764 1.76h14.473c.973 0 1.762-.787 1.764-1.76V4.76A1.765 1.765 0 0 0 19.236 3zM9.195 13.414c0 .755-.466 1.901-1.942 1.898H5.389V8.665h1.903c1.424 0 1.902 1.144 1.903 1.899v2.85zm4.045-3.562H11.1v1.544h1.309v1.188H11.1v1.543h2.142v1.188h-2.498a.813.813 0 0 1-.833-.792V9.497a.813.813 0 0 1 .792-.832h2.539l-.002 1.187zm4.165 4.632c-.531 1.235-1.481.99-1.906 0l-1.548-5.818h1.309l1.193 4.569 1.188-4.569h1.31l-1.546 5.818z",
};
---

<section
  id="home"
  class="relative flex min-h-[85vh] items-center overflow-hidden"
  data-reveal
>
  <!-- Atmosphere -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_1px_1px,rgb(0_0_0/0.05)_1px,transparent_0)] [background-size:28px_28px] dark:bg-[radial-gradient(circle_at_1px_1px,rgb(255_255_255/0.04)_1px,transparent_0)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute left-1/2 top-1/3 -z-10 h-[28rem] w-[28rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-500/[0.07] blur-3xl dark:bg-blue-500/10"
    aria-hidden="true"
  >
  </div>

  <div
    class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 py-20 text-center sm:px-6 lg:px-8"
  >
    {
      profile.freelanceAvailable && (
        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3.5 py-1.5 text-xs font-semibold text-emerald-700 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-400">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75" />
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500" />
          </span>
          Available for Opportunities
        </span>
      )
    }

    <h1
      class="mt-6 text-4xl font-extrabold leading-[1.08] tracking-tight text-gray-900 sm:text-5xl lg:text-6xl dark:text-white"
    >
      {profile.name}
      <span class="mt-2 block text-blue-600 dark:text-blue-400">
        {profile.heroText}
      </span>
    </h1>

    <p
      class="mt-5 flex h-7 items-center justify-center text-lg font-semibold text-gray-700 sm:text-xl dark:text-gray-200"
    >
      <span class="sr-only">{profile.roles.join(", ")}</span>
      <span aria-hidden="true">
        <span id="hero-role">{profile.roles[0]}</span><span
          id="hero-role-caret"
          class="ml-0.5 inline-block h-[1.1em] w-[2px] translate-y-[0.15em] animate-pulse bg-blue-600 dark:bg-blue-400"
        ></span>
      </span>
    </p>

    <p class="mt-4 max-w-xl text-base leading-relaxed text-gray-600 dark:text-gray-400">
      {profile.tagline}.
    </p>

    <div
      class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm text-gray-500 dark:text-gray-500"
    >
      <p class="inline-flex items-center gap-1.5">
        <MapPin class="h-4 w-4" aria-hidden="true" />
        {profile.location}
      </p>
      {
        currentJob && (
          <p>
            <span class="text-gray-300 dark:text-gray-700" aria-hidden="true">
              ·
            </span>
            {currentJob.role} @ {currentJob.company}
          </p>
        )
      }
    </div>

    <!-- CTAs + social -->
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a
        href="#projects"
        class="group inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-blue-700 hover:shadow-md active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900"
      >
        View Projects
        <ArrowRight
          class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
          aria-hidden="true"
        />
      </a>
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-gray-300 px-6 py-3.5 text-sm font-semibold text-gray-700 transition-all duration-200 hover:border-gray-400 hover:bg-gray-50 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-900 focus-visible:ring-offset-2 dark:border-gray-700 dark:text-gray-200 dark:hover:border-gray-600 dark:hover:bg-gray-800 dark:focus-visible:ring-white dark:focus-visible:ring-offset-gray-900"
      >
        <FileDown class="h-4 w-4" aria-hidden="true" />
        Download CV
      </a>
    </div>

    <ul class="mt-6 flex items-center justify-center gap-1">
      {
        social.map((item) => (
          <li>
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.platform}
              class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-gray-500 transition-colors duration-200 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
            >
              <svg
                class="h-5 w-5"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={socialIcons[item.icon]} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Stats -->
    <dl
      class="mt-12 grid w-full max-w-lg grid-cols-3 divide-x divide-gray-200 border-t border-gray-200 pt-8 dark:divide-gray-800 dark:border-gray-800"
    >
      {
        stats.map((stat) => (
          <div class="px-3 text-center sm:px-4">
            <dd class="text-2xl font-extrabold tracking-tight text-gray-900 dark:text-white">
              {stat.value}
            </dd>
            <dt class="mt-1 text-xs font-medium text-gray-500 dark:text-gray-400">
              {stat.label}
            </dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script define:vars={{ roles: profile.roles }}>
  const roleEl = document.getElementById("hero-role");
  const caretEl = document.getElementById("hero-role-caret");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (roleEl && roles.length > 1 && !reduceMotion) {
    let roleIndex = 0;
    let charIndex = roles[0].length;
    let deleting = true;

    const TYPE_MS = 70;
    const DELETE_MS = 35;
    const HOLD_MS = 1800;

    function tick() {
      if (deleting) {
        charIndex -= 1;
        if (charIndex <= 0) {
          charIndex = 0;
          deleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
        }
      } else {
        charIndex += 1;
        const next = roles[roleIndex];
        if (charIndex >= next.length) {
          charIndex = next.length;
          deleting = true;
          roleEl.textContent = next;
          setTimeout(tick, HOLD_MS);
          return;
        }
      }

      roleEl.textContent = roles[roleIndex].slice(0, charIndex);
      setTimeout(tick, deleting ? DELETE_MS : TYPE_MS);
    }

    setTimeout(tick, HOLD_MS);
  } else if (caretEl && reduceMotion) {
    caretEl.classList.remove("animate-pulse");
  }
</script>
