---
import { ArrowRight, FileDown, MapPin } from "@lucide/astro";
import { portfolioData as portfolio } from "../../data/portfolio";
import cvPdf from "../../assets/CV- Ogi Setiawan.pdf";

const { profile, projects, experience } = portfolio;

const yearsExperience = Math.max(
  1,
  Math.floor(
    (Date.now() - new Date(profile.experienceStartDate).getTime()) /
      (365.25 * 24 * 60 * 60 * 1000)
  )
);

const stats = [
  { value: yearsExperience, suffix: "+", label: "Years Experience" },
  { value: projects.length, suffix: "+", label: "Projects Delivered" },
  { value: 18, suffix: "+", label: "Certifications" },
];

const currentJob = experience.find((job) => job.current);
const displayName = profile.name.replace(/^I'm\s+/i, "").trim();
---

<section
  id="home"
  class="relative flex min-h-[85vh] items-center overflow-hidden bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgb(167_209_41_/_0.12),transparent_55%)] dark:bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgb(167_209_41_/_0.08),transparent_55%)]"
  aria-labelledby="hero-heading"
  itemscope
  itemtype="https://schema.org/Person"
>
  <div
    class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 py-20 text-center sm:px-6 lg:px-8"
  >
    {
      profile.freelanceAvailable && (
        <span class="inline-flex items-center gap-2 rounded-full border border-teal-200 bg-teal-50 px-3.5 py-1.5 font-mono text-xs font-semibold text-teal-700 dark:border-teal-400/30 dark:bg-teal-400/10 dark:text-teal-300">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75 motion-safe:animate-ping" />
            <span class="relative inline-flex h-2 w-2 rounded-full bg-teal-500" />
          </span>
          Available for Opportunities
        </span>
      )
    }

    <h1
      id="hero-heading"
      class="mt-6 font-display text-4xl font-semibold leading-[1.08] tracking-tight text-gray-900 sm:text-5xl lg:text-6xl dark:text-white"
    >
      <span itemprop="name">{displayName}</span>
      <span class="mt-2 block text-accent dark:text-accent-400">
        {profile.heroText}
      </span>
    </h1>

    <p
      class="mt-5 flex h-7 items-center justify-center text-lg font-semibold text-gray-700 sm:text-xl dark:text-gray-200"
    >
      <span class="sr-only" itemprop="jobTitle">{profile.title}</span>
      <span aria-hidden="true">
        <span id="hero-role">{profile.roles[0]}</span><span
          id="hero-role-caret"
          class="ml-0.5 inline-block h-[1.1em] w-[2px] translate-y-[0.15em] bg-accent motion-safe:animate-pulse dark:bg-accent-400"
        ></span>
      </span>
    </p>

    <p class="mt-4 max-w-xl text-base leading-relaxed text-gray-600 dark:text-gray-400">
      {profile.tagline}.
    </p>

    <div
      class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm text-gray-600 dark:text-gray-400"
    >
      <p class="inline-flex items-center gap-1.5">
        <MapPin class="h-4 w-4" aria-hidden="true" />
        {profile.location}
      </p>
      {
        currentJob && (
          <p>
            <span class="text-gray-400 dark:text-gray-500" aria-hidden="true">
              ·
            </span>
            {currentJob.role} at {currentJob.company}
          </p>
        )
      }
    </div>

    <!-- CTAs -->
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a
        href="#projects"
        class="group inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-sm font-semibold text-background shadow-sm transition-all duration-200 hover:bg-accent-600 hover:shadow-md active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900"
      >
        View Featured Projects
        <ArrowRight
          class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
          aria-hidden="true"
        />
      </a>
      <a
        href={cvPdf}
        download="CV-Ogi-Setiawan.pdf"
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-gray-300 px-6 py-3.5 text-sm font-semibold text-gray-700 transition-all duration-200 hover:border-gray-400 hover:bg-gray-50 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-900 focus-visible:ring-offset-2 dark:border-gray-700 dark:text-gray-200 dark:hover:border-gray-600 dark:hover:bg-gray-800 dark:focus-visible:ring-white dark:focus-visible:ring-offset-gray-900"
      >
        <FileDown class="h-4 w-4" aria-hidden="true" />
        Download CV
      </a>
    </div>

    <!-- Stats -->
    <dl
      class="mt-12 grid w-full max-w-lg grid-cols-3 divide-x divide-gray-200 border-t border-gray-200 pt-8 dark:divide-gray-800 dark:border-gray-800"
    >
      {
        stats.map((stat) => (
          <div class="px-3 text-center sm:px-4">
            <dd class="text-2xl font-extrabold tracking-tight text-gray-900 dark:text-white">
              {stat.value}
              <span class="text-accent dark:text-accent-400">{stat.suffix}</span>
            </dd>
            <dt class="mt-1 font-mono text-xs font-medium text-gray-500 dark:text-gray-400">
              {stat.label}
            </dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script define:vars={{ roles: profile.roles }}>
  const roleEl = document.getElementById("hero-role");
  const caretEl = document.getElementById("hero-role-caret");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (roleEl && roles.length > 1 && !reduceMotion) {
    let roleIndex = 0;
    let charIndex = roles[0].length;
    let deleting = true;

    const TYPE_MS = 70;
    const DELETE_MS = 35;
    const HOLD_MS = 1800;

    function tick() {
      if (deleting) {
        charIndex -= 1;
        if (charIndex <= 0) {
          charIndex = 0;
          deleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
        }
      } else {
        charIndex += 1;
        const next = roles[roleIndex];
        if (charIndex >= next.length) {
          charIndex = next.length;
          deleting = true;
          roleEl.textContent = next;
          setTimeout(tick, HOLD_MS);
          return;
        }
      }

      roleEl.textContent = roles[roleIndex].slice(0, charIndex);
      setTimeout(tick, deleting ? DELETE_MS : TYPE_MS);
    }

    setTimeout(tick, HOLD_MS);
  } else if (caretEl && reduceMotion) {
    caretEl.classList.remove("animate-pulse");
  }
</script>
