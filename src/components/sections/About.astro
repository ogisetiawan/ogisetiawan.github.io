---
import { Image } from "astro:assets";
import { portfolioData as portfolio } from "../../data/portfolio";

const { profile, services, social } = portfolio;

const intro = profile.about.split(/(?<=\.)\s+/).slice(0, 2).join(" ");
const profileLinks = social.filter(
  (item) => item.icon === "linkedin" || item.icon === "github"
);

const socialIcons: Record<string, string> = {
  linkedin:
    "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  github:
    "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
};
---

<section id="about" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="mb-12 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
      About Me
    </h2>
  </div>

  <div class="grid items-stretch gap-10 lg:grid-cols-12 lg:gap-10">
    <!-- Left: portrait + accent circle -->
    <div class="lg:col-span-6">
      <div class="relative mx-auto h-full min-h-[18rem] w-full max-w-lg lg:max-w-none">
        <div
          class="absolute left-[2%] top-[8%] h-[84%] w-[58%] rounded-full bg-blue-600 shadow-[0_18px_40px_-18px_rgb(37_99_235_/_0.55)] dark:bg-blue-500"
          aria-hidden="true"
        >
        </div>
        <Image
          src={profile.images.profile}
          alt={`Portrait of ${profile.name}`}
          class="relative z-10 h-full w-full object-contain object-right drop-shadow-[0_16px_28px_rgb(0_0_0_/_0.28)]"
        />
      </div>
    </div>

    <!-- Right: copy -->
    <div class="flex flex-col justify-center lg:col-span-6">
      <p class="text-base leading-relaxed text-gray-600 dark:text-gray-400">
        {intro}
      </p>

      <ul class="mt-8 grid gap-2 sm:grid-cols-2">
        {
          services.map((service) => (
            <li class="flex items-center gap-3 text-sm font-medium text-gray-800 dark:text-gray-200">
              <span
                class="h-px w-6 shrink-0 bg-blue-600 dark:bg-blue-400"
                aria-hidden="true"
              />
              {service.name}
            </li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-wrap gap-3">
        {
          profileLinks.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full border border-gray-300 px-4 py-2.5 text-sm font-semibold text-gray-800 transition-colors duration-200 hover:border-gray-900 hover:bg-gray-900 hover:text-white dark:border-gray-700 dark:text-gray-100 dark:hover:border-white dark:hover:bg-white dark:hover:text-gray-900"
            >
              <svg
                class="h-4 w-4"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={socialIcons[item.icon]} />
              </svg>
              {item.platform}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
