---
import OptimizedImage from "../ui/OptimizedImage.astro";
import { portfolioData as portfolio, featuredProjectOrder } from "../../data/portfolio";
import { ArrowUpRight, X, LayoutGrid } from "@lucide/astro";
import SkeletonOverlay from "../ui/SkeletonOverlay.astro";
import { iconSrc, resolveProjectTechs } from "../../lib/techIcons";

const featured = featuredProjectOrder.map((id) => {
  const project = portfolio.projects.find((p) => p.id === id);
  if (!project) throw new Error(`Featured project "${id}" not found in portfolio data`);
  if (!project.featured) throw new Error(`Project "${id}" must have featured: true`);
  return project;
});

const [hero, ...sideProjects] = featured;
const heroTechs = resolveProjectTechs(hero.technologies, 5);

const featuredIds = new Set<string>(featuredProjectOrder);
const otherProjects = portfolio.projects.filter((p) => !featuredIds.has(p.id));
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8" data-reveal>
  <div class="mb-12 text-center">
    <h2
      class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
    >
      Featured Projects
    </h2>
    <p class="mt-4 text-base text-gray-600 dark:text-gray-400">
      A selection of my best work — the rest is just one click away.
    </p>
  </div>

  <!-- Bento grid: 1 large + 2 medium -->
  <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
    <!-- Large card -->
    <article
      class="group relative flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-all duration-300 hover:shadow-xl lg:col-span-2 lg:row-span-2 dark:border-gray-800 dark:bg-gray-800"
      data-reveal-item
      data-skeleton
      style="--stagger: 0"
    >
      <SkeletonOverlay variant="project" />
      <a
        href={hero.url ?? "#projects"}
        target={hero.url ? "_blank" : undefined}
        rel="noopener noreferrer"
        class="flex h-full flex-col"
      >
        <div class="relative aspect-[16/9] overflow-hidden bg-gray-100 dark:bg-gray-900">
          <OptimizedImage
            src={hero.image}
            alt={`Screenshot of ${hero.title}`}
            width={1200}
            height={675}
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          {
            hero.url && (
              <span class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-gray-900 opacity-0 shadow-md transition-opacity duration-300 group-hover:opacity-100 dark:bg-gray-900/90 dark:text-white">
                <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
              </span>
            )
          }
        </div>
        <div class="flex flex-1 flex-col gap-4 p-6 sm:p-7">
          <div>
            <span
              class="mb-2 inline-block text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400"
            >
              {hero.category}
            </span>
            <h3 class="text-xl font-bold tracking-tight text-gray-900 sm:text-2xl dark:text-white">
              {hero.title}
            </h3>
            <p class="mt-3 max-w-prose text-sm leading-relaxed text-gray-600 sm:text-[15px] dark:text-gray-300">
              {hero.description}
            </p>
          </div>

          {
            hero.highlights && hero.highlights.length > 0 && (
              <ul class="flex flex-1 flex-col gap-2.5" aria-label="Project highlights">
                {hero.highlights.map((item) => (
                  <li class="flex gap-3 text-sm leading-snug text-gray-700 dark:text-gray-200">
                    <span
                      class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500 dark:bg-blue-400"
                      aria-hidden="true"
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )
          }

          <ul class="mt-auto flex flex-wrap gap-2 pt-1" aria-label="Tech stack">
            {
              heroTechs.map(({ label, icon }) => (
                <li class="inline-flex items-center gap-1.5 rounded-md border border-gray-200 bg-gray-50 px-2.5 py-1.5 text-xs font-medium text-gray-700 dark:border-gray-600 dark:bg-gray-900/40 dark:text-gray-200">
                  {icon && (
                    <img
                      src={iconSrc(icon)}
                      alt=""
                      width={16}
                      height={16}
                      loading="lazy"
                      class:list={[
                        "h-4 w-4 shrink-0",
                        icon.invertOnDark && "dark:invert",
                      ]}
                    />
                  )}
                  <span>{label}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </a>
    </article>

    <!-- Medium cards -->
    {
      sideProjects.map((project, i) => (
        <article
          class="group relative flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-all duration-300 hover:shadow-xl dark:border-gray-800 dark:bg-gray-800"
          data-reveal-item
          data-skeleton
          style={`--stagger: ${i + 1}`}
        >
          <SkeletonOverlay variant="project" />
          <a
            href={project.url ?? "#projects"}
            target={project.url ? "_blank" : undefined}
            rel="noopener noreferrer"
            class="flex h-full flex-col"
          >
            <div class="relative aspect-[16/9] overflow-hidden bg-gray-100 dark:bg-gray-900">
              <OptimizedImage
                src={project.image}
                alt={`Screenshot of ${project.title}`}
                width={600}
                height={338}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              {project.url && (
                <span class="absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-gray-900 opacity-0 shadow-md transition-opacity duration-300 group-hover:opacity-100 dark:bg-gray-900/90 dark:text-white">
                  <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
                </span>
              )}
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-base font-bold leading-snug text-gray-900 dark:text-white">
                {project.shortTitle}
              </h3>
              <p class="mt-1.5 line-clamp-2 flex-1 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {project.description}
              </p>
              <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tech stack">
                {resolveProjectTechs(project.technologies, 3).map(({ label, icon }) => (
                  <li class="inline-flex items-center gap-1.5 rounded-md border border-gray-200 bg-gray-50 px-2 py-1 text-[11px] font-medium text-gray-600 dark:border-gray-600 dark:bg-gray-900/40 dark:text-gray-300">
                    {icon && (
                      <img
                        src={iconSrc(icon)}
                        alt=""
                        width={14}
                        height={14}
                        loading="lazy"
                        class:list={[
                          "h-3.5 w-3.5 shrink-0",
                          icon.invertOnDark && "dark:invert",
                        ]}
                      />
                    )}
                    <span>{label}</span>
                  </li>
                ))}
              </ul>
            </div>
          </a>
        </article>
      ))
    }
  </div>

  <!-- View all button -->
  <div class="mt-10 text-center">
    <button
      type="button"
      id="open-projects-modal"
      class="inline-flex items-center gap-2 rounded-xl border border-gray-300 px-6 py-3 text-sm font-semibold text-gray-700 transition-all duration-200 hover:border-gray-400 hover:bg-gray-50 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-900 focus-visible:ring-offset-2 dark:border-gray-700 dark:text-gray-200 dark:hover:border-gray-600 dark:hover:bg-gray-800 dark:focus-visible:ring-white dark:focus-visible:ring-offset-gray-900"
    >
      <LayoutGrid class="h-4 w-4" aria-hidden="true" />
      View All Projects ({otherProjects.length} more)
    </button>
  </div>

  <!-- All projects modal -->
  <dialog
    id="projects-modal"
    class="fixed inset-0 z-50 m-auto w-full max-w-3xl rounded-2xl border border-gray-200 bg-white p-0 shadow-2xl backdrop:bg-black/60 dark:border-gray-700 dark:bg-gray-900"
    aria-labelledby="projects-modal-title"
  >
    <div
      class="sticky top-0 flex items-center justify-between border-b border-gray-200 bg-white px-6 py-4 dark:border-gray-700 dark:bg-gray-900"
    >
      <h3
        id="projects-modal-title"
        class="text-lg font-bold text-gray-900 dark:text-white"
      >
        All Projects
      </h3>
      <button
        type="button"
        id="close-projects-modal"
        aria-label="Close project list"
        class="flex h-9 w-9 items-center justify-center rounded-lg text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white dark:focus-visible:ring-white"
      >
        <X class="h-5 w-5" aria-hidden="true" />
      </button>
    </div>

    <div class="max-h-[70vh] overflow-y-auto px-6 py-4">
      <table class="w-full text-left text-sm">
        <thead>
          <tr
            class="border-b border-gray-200 text-xs uppercase tracking-wider text-gray-500 dark:border-gray-700 dark:text-gray-400"
          >
            <th scope="col" class="py-3 pr-4 font-semibold">Project</th>
            <th scope="col" class="hidden py-3 pr-4 font-semibold sm:table-cell">
              Tech
            </th>
            <th scope="col" class="py-3 font-semibold">
              <span class="sr-only">Link</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
          {
            otherProjects.map((project) => (
              <tr class="group/row">
                <td class="py-3.5 pr-4">
                  <p class="font-semibold text-gray-900 dark:text-white">
                    {project.title}
                  </p>
                  <p class="mt-0.5 line-clamp-1 text-xs text-gray-500 dark:text-gray-400">
                    {project.category}
                    {project.period && ` · ${project.period}`}
                  </p>
                </td>
                <td class="hidden py-3.5 pr-4 sm:table-cell">
                  <span class="text-xs text-gray-500 dark:text-gray-400">
                    {project.technologies.slice(0, 3).join(" · ")}
                  </span>
                </td>
                <td class="py-3.5 text-right">
                  {project.url ? (
                    <a
                      href={project.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Visit ${project.title}`}
                      class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:hover:bg-gray-800 dark:hover:text-white"
                    >
                      <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
                    </a>
                  ) : (
                    <span class="text-xs text-gray-300 dark:text-gray-600">
                      Private
                    </span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </dialog>
</section>

<script>
  const modal = document.getElementById(
    "projects-modal"
  ) as HTMLDialogElement | null;
  const openBtn = document.getElementById("open-projects-modal");
  const closeBtn = document.getElementById("close-projects-modal");

  openBtn?.addEventListener("click", () => {
    modal?.showModal();
    document.body.style.overflow = "hidden";
  });

  function closeModal() {
    modal?.close();
    document.body.style.overflow = "";
  }

  closeBtn?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  modal?.addEventListener("close", () => {
    document.body.style.overflow = "";
  });
</script>
