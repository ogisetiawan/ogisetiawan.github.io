---
import { portfolioData as portfolio } from "../../data/portfolio";
import { ArrowUpRight } from "@lucide/astro";

const LINKEDIN_CERTS =
  "https://www.linkedin.com/in/ogi-setiawan-software-engineer/details/certifications/";

// Keep only advanced / expert level, drop basic/pemula
const EXCLUDE = /pemula|dasar|fundamental/i;

const featured = portfolio.certifications
  .filter((cert) => !EXCLUDE.test(cert.name))
  .slice(0, 4);

interface IssuerMark {
  src: string;
  bg: string;
}

const ISSUER_MARKS: Record<string, IssuerMark> = {
  Google: {
    src: "https://cdn.simpleicons.org/google",
    bg: "bg-white dark:bg-gray-800",
  },
  "Dicoding Indonesia": {
    src: "https://www.google.com/s2/favicons?domain=dicoding.com&sz=64",
    bg: "bg-white dark:bg-gray-700",
  },
  "AWS AI Academy": {
    src: "https://www.google.com/s2/favicons?domain=aws.amazon.com&sz=64",
    bg: "bg-white dark:bg-gray-700",
  },
  "PT. Babastudio": {
    src: "https://www.google.com/s2/favicons?domain=babastudio.com&sz=64",
    bg: "bg-white dark:bg-gray-700",
  },
};

function issuerMark(issuer: string): IssuerMark {
  return (
    ISSUER_MARKS[issuer] ?? {
      src: `https://www.google.com/s2/favicons?domain=${encodeURIComponent(issuer)}&sz=64`,
      bg: "bg-white dark:bg-gray-700",
    }
  );
}

function parseCoursework(coursework: string): string[] {
  return coursework
    .split(",")
    .map((item) => item.trim())
    .filter(Boolean);
}
---

<section id="certifications" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="mb-12 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
      Certifications
    </h2>
    <p class="mt-4 text-base text-gray-600 dark:text-gray-400">
      Selected credentials that matter most.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      featured.map((cert) => {
        const mark = issuerMark(cert.issuer);
        const topics = parseCoursework(cert.coursework);
        return (
          <a
            href={cert.certificate ?? LINKEDIN_CERTS}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col rounded-xl border border-gray-200 bg-white p-4 transition-all duration-200 hover:border-gray-900 hover:shadow-md dark:border-gray-800 dark:bg-gray-800/60 dark:hover:border-gray-500"
          >
            <div class="mb-3 flex items-center justify-between gap-2">
              <span
                class:list={[
                  "flex h-9 w-9 flex-none items-center justify-center rounded-lg border border-gray-200 dark:border-gray-600",
                  mark.bg,
                ]}
              >
                <img
                  src={mark.src}
                  alt={`${cert.issuer} logo`}
                  width={18}
                  height={18}
                  class="h-[18px] w-[18px]"
                  loading="lazy"
                />
              </span>
              <time
                datetime={cert.date}
                class="font-mono text-[11px] text-gray-400 dark:text-gray-500"
              >
                {cert.date}
              </time>
            </div>

            <h3 class="line-clamp-2 text-sm font-bold leading-snug text-gray-900 group-hover:underline dark:text-white">
              {cert.name}
            </h3>
            <p class="mt-0.5 truncate text-xs text-gray-500 dark:text-gray-400">
              {cert.issuer}
            </p>

            {topics.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-1">
                {topics.slice(0, 3).map((topic) => (
                  <li class="rounded-md bg-gray-100 px-1.5 py-0.5 text-[10px] font-medium text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                    {topic}
                  </li>
                ))}
              </ul>
            )}
          </a>
        );
      })
    }
  </div>

  <div class="mt-10 text-center">
    <a
      href={LINKEDIN_CERTS}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-xl bg-[#0A66C2] px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-[#084d92] hover:shadow-md active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0A66C2] focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900"
    >
      View All Certifications on LinkedIn
      <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
    </a>
  </div>
</section>
