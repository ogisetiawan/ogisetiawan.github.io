---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { portfolioData as portfolio } from "../../data/portfolio";
import { ArrowUpRight } from "@lucide/astro";
import SkeletonOverlay from "../ui/SkeletonOverlay.astro";
import { domainLogos, googleIconDataUri } from "../../lib/brandLogos";

const LINKEDIN_CERTS =
  "https://www.linkedin.com/in/ogi-setiawan-software-engineer/details/certifications/";

const EXCLUDE = /pemula|dasar|fundamental/i;

const featured = portfolio.certifications
  .filter((cert) => !EXCLUDE.test(cert.name))
  .slice(0, 4);

interface IssuerMark {
  /** Either a data URI / string src, or a bundled image to optimize. */
  src?: string;
  image?: ImageMetadata;
  bg: string;
}

const ISSUER_MARKS: Record<string, IssuerMark> = {
  Google: {
    src: googleIconDataUri,
    bg: "bg-white dark:bg-white",
  },
  "Dicoding Indonesia": {
    image: domainLogos["dicoding.com"],
    bg: "bg-white dark:bg-white",
  },
  "AWS AI Academy": {
    image: domainLogos["aws.amazon.com"],
    bg: "bg-white dark:bg-white",
  },
  "PT. Babastudio": {
    image: domainLogos["babastudio.com"],
    bg: "bg-white dark:bg-white",
  },
};

const MONTHS: Record<string, string> = {
  Jan: "January",
  Feb: "February",
  Mar: "March",
  Apr: "April",
  May: "May",
  Jun: "June",
  Jul: "July",
  Aug: "August",
  Sep: "September",
  Oct: "October",
  Nov: "November",
  Dec: "December",
};

function issuerMark(issuer: string): IssuerMark {
  return (
    ISSUER_MARKS[issuer] ?? {
      src: googleIconDataUri,
      bg: "bg-white dark:bg-white",
    }
  );
}

function parseCoursework(coursework: string): string[] {
  return coursework
    .split(",")
    .map((item) => item.trim())
    .filter(Boolean);
}

function formatCertDate(date: string): { label: string; datetime: string } {
  const parts = date.trim().split(/\s+/);
  const monthRaw = parts[0] ?? date;
  const year = parts[1] ?? "";
  const abbr = monthRaw.slice(0, 3);
  const month = MONTHS[abbr] ?? MONTHS[monthRaw] ?? monthRaw;
  const monthIndex = Object.keys(MONTHS).indexOf(abbr);

  return {
    label: year ? `${month} ${year}` : month,
    datetime:
      monthIndex >= 0 && year
        ? `${year}-${String(monthIndex + 1).padStart(2, "0")}`
        : date,
  };
}

---

<section id="certifications" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8" data-reveal>
  <div class="mb-12 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
      Certifications
    </h2>
    <p class="mt-4 text-base text-gray-600 dark:text-gray-400">
      Selected credentials that matter most.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      featured.map((cert, i) => {
        const mark = issuerMark(cert.issuer);
        const topics = parseCoursework(cert.coursework);
        const { label: dateLabel, datetime } = formatCertDate(cert.date);
        return (
          <a
            href={cert.certificate ?? LINKEDIN_CERTS}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white p-4 transition-all duration-200 hover:scale-[1.03] hover:border-blue-500 hover:shadow-md dark:border-gray-800 dark:bg-gray-800/60 dark:hover:border-blue-500"
            data-reveal-item
            data-skeleton
            style={`--stagger: ${i}`}
          >
            <SkeletonOverlay variant="cert" />
            <div class="mb-3 flex items-center justify-between gap-2">
                <span
                  class:list={[
                    "flex h-11 w-11 flex-none items-center justify-center overflow-hidden rounded-lg border border-gray-200 p-1.5 dark:border-gray-600",
                    mark.bg,
                  ]}
                >
                  {mark.image ? (
                    <Image
                      src={mark.image}
                      alt={`${cert.issuer} logo`}
                      width={32}
                      height={32}
                      class="h-8 w-8 object-contain"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <img
                      src={mark.src}
                      alt={`${cert.issuer} logo`}
                      width={32}
                      height={32}
                      class="h-8 w-8 object-contain"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </span>
              <time
                datetime={datetime}
                class="rounded-md bg-blue-50 px-2 py-1 text-xs font-semibold text-blue-700 dark:bg-blue-950/50 dark:text-blue-300"
              >
                {dateLabel}
              </time>
            </div>

            <h3 class="line-clamp-2 text-sm font-bold leading-snug text-gray-900 group-hover:underline dark:text-white">
              {cert.name}
            </h3>
            <p class="mt-0.5 truncate text-xs text-gray-500 dark:text-gray-400">
              {cert.issuer}
            </p>

            {topics.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-1">
                {topics.slice(0, 3).map((topic) => (
                  <li class="rounded-md bg-gray-100 px-1.5 py-0.5 text-[10px] font-medium text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                    {topic}
                  </li>
                ))}
              </ul>
            )}
          </a>
        );
      })
    }
  </div>

  <div class="mt-10 text-center">
    <a
      href={LINKEDIN_CERTS}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-xl bg-[#0A66C2] px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-[#084d92] hover:shadow-md active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0A66C2] focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900"
    >
      View All Certifications on LinkedIn
      <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
    </a>
  </div>
</section>
