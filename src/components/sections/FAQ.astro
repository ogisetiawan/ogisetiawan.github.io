---
import { ChevronDown } from "@lucide/astro";
import SectionHeading from "../ui/SectionHeading.astro";

const faqs = [
  {
    question: "What is your primary tech stack?",
    answerHtml:
      "I specialize in modern frontend frameworks like <strong>Astro, React, and TypeScript</strong>, paired with robust backend technologies such as <strong>Node.js, PHP (CodeIgniter/Laravel), and MySQL</strong>. I also have deep expertise in enterprise integrations like SAP B1 and Bitrix24.",
  },
  {
    question: "What kind of projects do you usually handle?",
    answerHtml:
      "I focus on <strong>enterprise web applications, business automation, and AI workflow integrations</strong>. My experience includes building scalable systems for regional markets, modernizing legacy infrastructure, and developing custom CRM solutions.",
  },
  {
    question: "Are you available for freelance or full-time opportunities?",
    answerHtml:
      "Yes, I am currently open to new opportunities, particularly remote or hybrid roles involving complex system architecture, fullstack development, or AI automation projects. You can reach me via the contact form or WhatsApp.",
  },
] as const;

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answerHtml.replace(/<\/?strong>/g, ""),
    },
  })),
};
---

<section
  id="faq"
  class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8"
  data-reveal
  aria-labelledby="faq-heading"
>
  <SectionHeading
    id="faq-heading"
    title="Frequently Asked Questions"
    subtitle="Quick answers about my stack, project focus, and availability."
  />

  <div class="mx-auto max-w-3xl space-y-3">
    {
      faqs.map((item) => (
        <details class="group/faq rounded-xl border border-gray-200 bg-elevated open:shadow-sm dark:border-gray-800 dark:bg-gray-800/60">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-sm font-semibold text-gray-900 transition-colors hover:text-accent-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-inset [&::-webkit-details-marker]:hidden dark:text-white dark:hover:text-accent-400">
            <span>{item.question}</span>
            <ChevronDown
              class="h-5 w-5 shrink-0 text-accent-600 transition-transform duration-200 group-open/faq:rotate-180 dark:text-accent-400"
              aria-hidden="true"
            />
          </summary>
          <div class="border-t border-gray-100 px-5 pb-5 pt-4 dark:border-gray-700">
            <p
              class="text-sm leading-relaxed text-gray-600 dark:text-gray-300 [&_strong]:font-mono [&_strong]:font-semibold [&_strong]:text-gray-900 dark:[&_strong]:text-white"
              set:html={item.answerHtml}
            />
          </div>
        </details>
      ))
    }
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
