---
import { Image } from "astro:assets";
import { Briefcase, ChevronDown, GraduationCap } from "@lucide/astro";
import { portfolioData as portfolio } from "../../data/portfolio";
import SkeletonOverlay from "../ui/SkeletonOverlay.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { logoForDomain, domainLogos } from "../../lib/brandLogos";
import type { ImageMetadata } from "astro";

const { experience, education } = portfolio;

// Company → domain (self-hosted brand logos, no external favicon service)
const companyDomains: Record<string, string> = {
  "Behn Meyer Group": "behnmeyer.com",
  Maha: "mahachem.com",
  "Maha Chemicals (Asia) Pte Ltd": "mahachem.com",
  StarHits: "starhits.id",
  "PT Kaldu Sari Nabati Indonesia": "nabatisnack.co.id",
};

function companyLogo(name: string): ImageMetadata | null {
  const domain = companyDomains[name];
  return domain ? logoForDomain(domain) : null;
}

const unpamLogo = domainLogos["unpam.ac.id"];

function initials(name: string): string {
  return name
    .replace(/^(PT\.?\s+)/i, "")
    .split(/\s+/)
    .slice(0, 2)
    .map((word) => word[0])
    .join("")
    .toUpperCase();
}

function parseResponsibility(text: string): { body: string; metric: string | null } {
  const match = text.match(/^(.*?)\s*\[Metric:\s*(.+?)\]\s*$/i);
  if (!match) return { body: text, metric: null };
  return { body: match[1].trim(), metric: match[2].trim() };
}
---

<section id="experience" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8" aria-labelledby="experience-heading" data-reveal>
  <SectionHeading
    id="experience-heading"
    title="Experience & Education"
    subtitle={`${experience.length} roles across ${new Set(experience.map((job) => job.company)).size} companies`}
  />

  <div class="grid gap-12 lg:grid-cols-2">
    <!-- Work experience: scrollable timeline, ~3 rows visible -->
    <div>
      <SectionHeading
        id="work-experience-heading"
        level={3}
        align="start"
        title="Work Experience"
        showArrow={false}
      >
        <Briefcase
          slot="icon"
          class="h-6 w-6 text-accent-600 dark:text-accent-400"
          aria-hidden="true"
        />
      </SectionHeading>

      <div class="relative">
        <div
          class="max-h-[34rem] overflow-y-auto overscroll-contain pr-1 [scrollbar-width:thin] [scrollbar-color:theme(colors.gray.300)_transparent] dark:[scrollbar-color:theme(colors.gray.700)_transparent]"
        >
          <ol class="relative space-y-6">
            <span
              class="absolute bottom-8 left-[7px] top-8 w-px bg-gray-200 dark:bg-gray-700"
              aria-hidden="true"
            />
            {
              experience.map((job, i) => {
                const logo = companyLogo(job.company);
                return (
                  <li class="grid grid-cols-[1rem_minmax(0,1fr)] items-start gap-x-4">
                    <span
                      class="relative z-10 mt-5 flex h-4 w-4 items-center justify-center rounded-full border-2 border-white bg-accent dark:border-gray-900 dark:bg-accent-400"
                      aria-hidden="true"
                    />
                    <div
                      class="relative overflow-hidden rounded-xl border border-gray-200 bg-elevated p-5 shadow-sm transition-shadow duration-200 hover:shadow-md dark:border-gray-800 dark:bg-gray-800"
                      data-reveal-item
                      data-skeleton
                      style={`--stagger: ${i}`}
                    >
                      <SkeletonOverlay variant="experience" />
                      <div class="mb-3 flex items-start gap-3">
                        <span class="relative flex h-11 w-11 flex-none items-center justify-center overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-gray-700">
                          <span
                            class="text-xs font-mono font-extrabold tracking-wide text-gray-400 dark:text-gray-500"
                            aria-hidden="true"
                          >
                            {initials(job.company)}
                          </span>
                          {logo && (
                            <Image
                              src={logo}
                              alt={`${job.company} logo`}
                              width={44}
                              height={44}
                              loading="lazy"
                              decoding="async"
                              class="absolute inset-0 h-full w-full bg-white object-contain p-1"
                            />
                          )}
                        </span>
                        <div class="min-w-0 flex-1">
                          <div class="flex flex-wrap items-center gap-2">
                            <h4 class="text-base font-bold leading-snug text-gray-900 dark:text-white">
                              {job.role}
                            </h4>
                            {job.current && (
                              <span class="inline-flex items-center gap-2 rounded-full border border-teal-200 bg-teal-50 px-3.5 py-1.5 font-mono text-xs font-semibold text-teal-700 dark:border-teal-400/30 dark:bg-teal-400/10 dark:text-teal-300">
                                <span class="relative flex h-2 w-2" aria-hidden="true">
                                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-75" />
                                  <span class="relative inline-flex h-2 w-2 rounded-full bg-teal-500" />
                                </span>
                                Current
                              </span>
                            )}
                          </div>
                          <p class="truncate text-sm font-medium text-gray-500 dark:text-gray-400">
                            {job.company}
                          </p>
                        </div>
                      </div>

                      <div class="mb-3 flex flex-wrap items-center gap-2">
                        <time class="rounded bg-gray-100 px-2 py-0.5 font-mono text-xs font-medium text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                          {job.startDate} - {job.endDate}
                        </time>
                      </div>

                      <details class="group/responsibilities border-t border-gray-100 pt-3 dark:border-gray-700">
                        <summary
                          class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-2 py-2 text-sm font-bold text-gray-900 transition-colors hover:text-accent-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden dark:text-white dark:hover:text-accent-400 dark:focus-visible:ring-offset-gray-800"
                        >
                          <ChevronDown
                            class="h-4 w-4 shrink-0 text-accent-600 transition-colors transition-transform duration-200 group-open/responsibilities:rotate-180 group-open/responsibilities:text-white dark:text-accent-400 dark:group-open/responsibilities:text-white"
                            aria-hidden="true"
                          />
                          <span>Job Descriptions</span>
                        </summary>

                        <ul class="mt-3 list-disc space-y-2 border-t border-gray-100 px-2 pt-3 pl-6 text-sm leading-relaxed text-gray-600 dark:border-gray-700 dark:text-gray-300">
                          {job.responsibilities.map((item) => {
                            const { body, metric } = parseResponsibility(item);
                            return (
                              <li>
                                {body}
                                {metric && (
                                  <>
                                    {" "}
                                    <span class="italic text-accent-600 dark:text-accent-400">
                                      [Metric: {metric}]
                                    </span>
                                  </>
                                )}
                              </li>
                            );
                          })}
                        </ul>
                      </details>
                    </div>
                  </li>
                );
              })
            }
          </ol>
        </div>

        <!-- Fade hint: more content below (cards only, not timeline gutter) -->
        <div
          class="pointer-events-none absolute inset-y-auto bottom-0 left-8 right-0 h-16 bg-gradient-to-t from-page to-transparent dark:from-gray-900"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>

    <!-- Education -->
    <div>
      <SectionHeading
        id="education-heading"
        level={3}
        align="start"
        title="Education"
        showArrow={false}
      >
        <GraduationCap
          slot="icon"
          class="h-6 w-6 text-accent-600 dark:text-accent-400"
          aria-hidden="true"
        />
      </SectionHeading>

      <ol class="relative space-y-6">
        <span
          class="absolute bottom-8 left-[7px] top-8 w-px bg-gray-200 dark:bg-gray-700"
          aria-hidden="true"
        />
        {
          education.map((edu, i) => (
            <li class="grid grid-cols-[1rem_minmax(0,1fr)] items-start gap-x-4">
              <span
                class="relative z-10 mt-5 flex h-4 w-4 items-center justify-center rounded-full border-2 border-white bg-accent dark:border-gray-900 dark:bg-accent-400"
                aria-hidden="true"
              />
              <div
                class="relative overflow-hidden rounded-xl border border-gray-200 bg-elevated p-5 shadow-sm dark:border-gray-800 dark:bg-gray-800"
                data-reveal-item
                data-skeleton
                style={`--stagger: ${i}`}
              >
                <SkeletonOverlay variant="experience" />
                <div class="mb-3 flex items-start gap-3">
                  <span class="relative flex h-11 w-11 flex-none items-center justify-center overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-gray-700">
                    <span
                      class="text-xs font-mono font-extrabold tracking-wide text-gray-400 dark:text-gray-500"
                      aria-hidden="true"
                    >
                      {initials(edu.institution)}
                    </span>
                    <Image
                      src={unpamLogo}
                      alt={`${edu.institution} logo`}
                      width={44}
                      height={44}
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full bg-white object-contain p-1"
                    />
                  </span>
                  <div class="min-w-0 flex-1">
                    <h4 class="text-base font-bold leading-snug text-gray-900 dark:text-white">
                      {edu.degree}
                      {edu.field ? ` — ${edu.field}` : ""}
                    </h4>
                    <p class="truncate text-sm font-medium text-gray-500 dark:text-gray-400">
                      {edu.institution}
                    </p>
                  </div>
                </div>
                <time class="mb-3 inline-block rounded bg-gray-100 px-2 py-0.5 font-mono text-xs font-medium text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                  {edu.startDate} - {edu.endDate}
                </time>
                <ul class="list-disc space-y-2 pl-4 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                  {edu.description.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
