---
import { Briefcase, GraduationCap } from "@lucide/astro";
import { portfolioData as portfolio } from "../../data/portfolio";
import SkeletonOverlay from "../ui/SkeletonOverlay.astro";

const { experience, education } = portfolio;

// Company domains for logo lookup (Google favicon service, 128px)
const companyDomains: Record<string, string> = {
  "Behn Meyer Group": "https://www.behnmeyer.com/",
  Maha: "mahachem.com",
  "Maha Chemicals (Asia) Pte Ltd": "mahachem.com",
  StarHits: "starhits.id",
  "PT Kaldu Sari Nabati Indonesia": "https://www.nabatisnack.co.id/",
};

function logoUrl(name: string): string | null {
  const domain = companyDomains[name];
  return domain
    ? `https://www.google.com/s2/favicons?domain=${domain}&sz=128`
    : null;
}

function initials(name: string): string {
  return name
    .replace(/^(PT\.?\s+)/i, "")
    .split(/\s+/)
    .slice(0, 2)
    .map((word) => word[0])
    .join("")
    .toUpperCase();
}

function parseResponsibility(text: string): { body: string; metric: string | null } {
  const match = text.match(/^(.*?)\s*\[Metric:\s*(.+?)\]\s*$/i);
  if (!match) return { body: text, metric: null };
  return { body: match[1].trim(), metric: match[2].trim() };
}
---

<section id="experience" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8" data-reveal>
  <div class="mb-12 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
      Experience &amp; Education
    </h2>
    <p class="mt-4 text-base text-gray-600 dark:text-gray-400">
      {experience.length} roles across {new Set(experience.map((job) => job.company)).size} companies 
    </p>
  </div>

  <div class="grid gap-12 lg:grid-cols-2">
    <!-- Work experience: scrollable timeline, ~3 rows visible -->
    <div>
      <h3 class="mb-8 flex items-center gap-2 text-xl font-bold text-gray-900 dark:text-white">
        <Briefcase class="h-6 w-6 text-blue-600 dark:text-blue-400" aria-hidden="true" />
        Work Experience
      </h3>

      <div class="relative">
        <div
          class="max-h-[34rem] overflow-y-auto overscroll-contain pr-1 [scrollbar-width:thin] [scrollbar-color:theme(colors.gray.300)_transparent] dark:[scrollbar-color:theme(colors.gray.700)_transparent]"
        >
          <ol class="relative space-y-6">
            <span
              class="absolute bottom-8 left-[7px] top-8 w-px bg-gray-200 dark:bg-gray-700"
              aria-hidden="true"
            />
            {
              experience.map((job, i) => {
                const logo = logoUrl(job.company);
                return (
                  <li class="grid grid-cols-[1rem_minmax(0,1fr)] items-start gap-x-4">
                    <span
                      class="relative z-10 mt-5 flex h-4 w-4 items-center justify-center rounded-full border-2 border-white bg-gray-900 dark:border-gray-900 dark:bg-white"
                      aria-hidden="true"
                    />
                    <div
                      class="relative overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition-shadow duration-200 hover:shadow-md dark:border-gray-800 dark:bg-gray-800"
                      data-reveal-item
                      data-skeleton
                      style={`--stagger: ${i}`}
                    >
                      <SkeletonOverlay variant="experience" />
                      <div class="mb-3 flex items-start gap-3">
                        <span class="relative flex h-11 w-11 flex-none items-center justify-center overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-gray-700">
                          <span
                            class="text-xs font-extrabold tracking-wide text-gray-400 dark:text-gray-500"
                            aria-hidden="true"
                          >
                            {initials(job.company)}
                          </span>
                          {logo && (
                            <img
                              src={logo}
                              alt={`${job.company} logo`}
                              width={44}
                              height={44}
                              loading="lazy"
                              decoding="async"
                              class="absolute inset-0 h-full w-full bg-white object-contain p-1"
                              onerror="this.remove()"
                            />
                          )}
                        </span>
                        <div class="min-w-0 flex-1">
                          <div class="flex flex-wrap items-center gap-2">
                            <h4 class="text-base font-bold leading-snug text-gray-900 dark:text-white">
                              {job.role}
                            </h4>
                            {job.current && (
                              <span class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3.5 py-1.5 text-xs font-semibold text-emerald-700 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-400">
                                <span class="relative flex h-2 w-2" aria-hidden="true">
                                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75" />
                                  <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500" />
                                </span>
                                Current
                              </span>
                            )}
                          </div>
                          <p class="truncate text-sm font-medium text-gray-500 dark:text-gray-400">
                            {job.company}
                          </p>
                        </div>
                      </div>

                      <div class="mb-3 flex flex-wrap items-center gap-2">
                        <time class="rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                          {job.startDate} - {job.endDate}
                        </time>
                      </div>

                      <ul class="list-disc space-y-2 pl-4 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                        {job.responsibilities.map((item) => {
                          const { body, metric } = parseResponsibility(item);
                          return (
                            <li>
                              {body}
                              {metric && (
                                <>
                                  {" "}
                                  <span class="italic text-blue-600 dark:text-blue-400">
                                    [Metric: {metric}]
                                  </span>
                                </>
                              )}
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  </li>
                );
              })
            }
          </ol>
        </div>

        <!-- Fade hint: more content below (cards only, not timeline gutter) -->
        <div
          class="pointer-events-none absolute inset-y-auto bottom-0 left-8 right-0 h-16 bg-gradient-to-t from-white to-transparent dark:from-gray-900"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>

    <!-- Education -->
    <div>
      <h3 class="mb-8 flex items-center gap-2 text-xl font-bold text-gray-900 dark:text-white">
        <GraduationCap class="h-6 w-6 text-blue-600 dark:text-blue-400" aria-hidden="true" />
        Education
      </h3>

      <ol class="relative space-y-6">
        <span
          class="absolute bottom-8 left-[7px] top-8 w-px bg-gray-200 dark:bg-gray-700"
          aria-hidden="true"
        />
        {
          education.map((edu, i) => (
            <li class="grid grid-cols-[1rem_minmax(0,1fr)] items-start gap-x-4">
              <span
                class="relative z-10 mt-5 flex h-4 w-4 items-center justify-center rounded-full border-2 border-white bg-gray-900 dark:border-gray-900 dark:bg-white"
                aria-hidden="true"
              />
              <div
                class="relative overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-800"
                data-reveal-item
                data-skeleton
                style={`--stagger: ${i}`}
              >
                <SkeletonOverlay variant="experience" />
                <div class="mb-3 flex items-start gap-3">
                  <span class="relative flex h-11 w-11 flex-none items-center justify-center overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-gray-700">
                    <span
                      class="text-xs font-extrabold tracking-wide text-gray-400 dark:text-gray-500"
                      aria-hidden="true"
                    >
                      {initials(edu.institution)}
                    </span>
                    <img
                      src="https://www.google.com/s2/favicons?domain=unpam.ac.id&sz=128"
                      alt={`${edu.institution} logo`}
                      width={44}
                      height={44}
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full bg-white object-contain p-1"
                      onerror="this.remove()"
                    />
                  </span>
                  <div class="min-w-0 flex-1">
                    <h4 class="text-base font-bold leading-snug text-gray-900 dark:text-white">
                      {edu.degree}
                      {edu.field ? ` — ${edu.field}` : ""}
                    </h4>
                    <p class="truncate text-sm font-medium text-gray-500 dark:text-gray-400">
                      {edu.institution}
                    </p>
                  </div>
                </div>
                <time class="mb-3 inline-block rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                  {edu.startDate} - {edu.endDate}
                </time>
                <ul class="list-disc space-y-2 pl-4 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                  {edu.description.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
